+            int iR = i, jR = j, kR = k;
+
+            if (direction == FluxHandler<IntegratorDerivedClass>::Xdir) { iL = i-1; iR = i; }
+#if AMREX_SPACEDIM >= 2
+            if (direction == FluxHandler<IntegratorDerivedClass>::Ydir) { jL = j-1; jR = j; }
+#endif
+#if AMREX_SPACEDIM == 3
+            if (direction == FluxHandler<IntegratorDerivedClass>::Zdir) { kL = k-1; kR = k; }
+#endif
