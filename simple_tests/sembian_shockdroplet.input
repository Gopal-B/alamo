# ============================================================
# SIMPLE TEST 2: DI5 Sembian-style shock-droplet case
# Branch: DI/develop
# Purpose: quick test of shockdroplet IC + DI5 + WENO + positivity
# ============================================================

# -------------------------
# Simulation control
# -------------------------
plot_file = simple_sembian_shockdroplet

timestep  = 5.0e-7
stop_time = 1.0e-4
max_step  = 1000

# -------------------------
# Grid / AMR
# -------------------------
amr.plot_int        = 50
amr.max_level       = 0
amr.n_cell          = 160 48 1
amr.blocking_factor = 1
amr.regrid_int      = -1
amr.grid_eff        = 1.0

geometry.prob_lo     = 0.0   0.0    0.0
geometry.prob_hi     = 0.08  0.024  0.1
geometry.is_periodic = 0 0 0
geometry.mode        = cartesian

# -------------------------
# Solver
# -------------------------
SolverType          = SolveFiveEquationModel
cflNumber           = 0.5

TimeSteppingScheme  = RK3
FluxScheme          = HLLC
FluxReconstruction  = WENO
WenoVariant         = WENOZ5
ReconstructionMode  = Characteristic

# -------------------------
# EOS
# Phase 1 = liquid water, Phase 2 = air
# -------------------------
ic.shock.pvec.gamma1 = 6.68
ic.shock.pvec.gamma2 = 1.4
ic.shock.pvec.pi1    = 3.05e8
ic.shock.pvec.pi2    = 0.0

# -------------------------
# Initial condition: shock-droplet
# -------------------------
ic.pvec.type        = shockdroplet
ic.pressure.type    = shockdroplet

# Driver gas slab
ic.shockdroplet.geometry.x_driver_lo = 1.5e-3
ic.shockdroplet.geometry.x_driver_hi = 2.5e-3
ic.shockdroplet.geometry.y_driver_lo = 0.0
ic.shockdroplet.geometry.y_driver_hi = 2.4e-2

# Liquid droplet
ic.shockdroplet.geometry.droplet_center_x = 2.0e-2
ic.shockdroplet.geometry.droplet_center_y = 1.2e-2
ic.shockdroplet.geometry.droplet_radius   = 5.0e-3
ic.shockdroplet.geometry.interface_thickness = 2.0e-4

ic.shockdroplet.phase1_is_liquid = true

# Ambient gas
ic.shockdroplet.ambient.rho = 1.17
ic.shockdroplet.ambient.p   = 1.01e5
ic.shockdroplet.ambient.u   = 0.0
ic.shockdroplet.ambient.v   = 0.0

# Driver gas
ic.shockdroplet.driver.rho = 580.7
ic.shockdroplet.driver.p   = 5.0e7
ic.shockdroplet.driver.u   = 0.0
ic.shockdroplet.driver.v   = 0.0

# Liquid droplet
ic.shockdroplet.liquid.rho = 1000.0
ic.shockdroplet.liquid.p   = 1.01e5
ic.shockdroplet.liquid.u   = 0.0
ic.shockdroplet.liquid.v   = 0.0

# -------------------------
# Boundary conditions
# Components: [M1, M2, MOMX, MOMY, ETOT, ALPHA]
# -------------------------
bc.pvec.type.xlo = neumann neumann neumann neumann neumann neumann
bc.pvec.type.xhi = neumann neumann neumann neumann neumann neumann
bc.pvec.type.ylo = neumann neumann neumann neumann neumann neumann
bc.pvec.type.yhi = neumann neumann neumann neumann neumann neumann
bc.pvec.type.zlo = neumann neumann neumann neumann neumann neumann
bc.pvec.type.zhi = neumann neumann neumann neumann neumann neumann

bc.pvec.val.xlo  = 0 0 0 0 0 0
bc.pvec.val.xhi  = 0 0 0 0 0 0
bc.pvec.val.ylo  = 0 0 0 0 0 0
bc.pvec.val.yhi  = 0 0 0 0 0 0
bc.pvec.val.zlo  = 0 0 0 0 0 0
bc.pvec.val.zhi  = 0 0 0 0 0 0

bc.pressure.type.xlo = neumann
bc.pressure.type.xhi = neumann
bc.pressure.type.ylo = neumann
bc.pressure.type.yhi = neumann
bc.pressure.type.zlo = neumann
bc.pressure.type.zhi = neumann

bc.pressure.val.xlo = 0
bc.pressure.val.xhi = 0
bc.pressure.val.ylo = 0
bc.pressure.val.yhi = 0
bc.pressure.val.zlo = 0
bc.pressure.val.zhi = 0

# -------------------------
# DI5 positivity limiter
# -------------------------
enable_di5_face_positivity     = true
di5_partial_density_floor      = 1.0e-12
di5_alpha_floor                = 1.0e-12
di5_pressure_floor             = 1.0
di5_positivity_bisection_iters = 24

# THINC is kept explicit. Turn on later if you want sharper droplet interface.
enable_di5_thinc = false

# Refinement flags off for simple test
enable_density_refinement   = false
enable_pressure_refinement  = false
enable_velocity_refinement  = false
enable_vorticity_refinement = false
