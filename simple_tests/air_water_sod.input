# ============================================================
# SIMPLE TEST 1: DI5 air-water Sod/shock-tube case
# Branch: DI/develop
# Purpose: quick smoke test of DI5 + WENO-IS + positivity + THINC
# Notes: coarse 1D-like 2D grid; not a production validation case.
# ============================================================

# -------------------------
# Simulation control
# -------------------------
plot_file = simple_aw_sod

timestep  = 1.0e-7
stop_time = 2.5e-5
max_step  = 5000

# -------------------------
# Grid / AMR
# -------------------------
amr.plot_int        = 100
amr.max_level       = 0
amr.n_cell          = 400 4 1
amr.blocking_factor = 1
amr.regrid_int      = -1
amr.grid_eff        = 1.0

geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 1.0 0.01 0.1
geometry.is_periodic = 0 0 0
geometry.mode        = cartesian

# -------------------------
# Solver
# -------------------------
SolverType          = SolveFiveEquationModel
cflNumber           = 0.5

TimeSteppingScheme  = RK3
FluxScheme          = HLLC
FluxReconstruction  = WENO
WenoVariant         = WENOIS5
ReconstructionMode  = Characteristic

# -------------------------
# EOS
# Phase 1 = water, Phase 2 = air
# -------------------------
ic.shock.pvec.gamma1 = 4.4
ic.shock.pvec.gamma2 = 1.4
ic.shock.pvec.pi1    = 6.0e8
ic.shock.pvec.pi2    = 0.0

# -------------------------
# Initial condition
# Left side: water, high pressure
# Right side: air, low pressure
# -------------------------
ic.pvec.type        = shock
ic.pressure.type    = shock

ic.shock.count      = 1
ic.shock.positions  = 0.7
ic.shock.direction  = xdir

ic.shock.pvec.rho1  = 1000.0 1000.0
ic.shock.pvec.rho2  = 50.0   50.0
ic.shock.pvec.alpha = 1.0    0.0

ic.shock.pvec.uvel  = 0.0    0.0
ic.shock.pvec.vvel  = 0.0    0.0

ic.shock.pressure   = 1.0e9  1.0e5

# -------------------------
# Boundary conditions
# Components: [M1, M2, MOMX, MOMY, ETOT, ALPHA]
# -------------------------
bc.pvec.type.xlo = neumann neumann neumann neumann neumann neumann
bc.pvec.type.xhi = neumann neumann neumann neumann neumann neumann
bc.pvec.type.ylo = neumann neumann neumann neumann neumann neumann
bc.pvec.type.yhi = neumann neumann neumann neumann neumann neumann
bc.pvec.type.zlo = neumann neumann neumann neumann neumann neumann
bc.pvec.type.zhi = neumann neumann neumann neumann neumann neumann

bc.pvec.val.xlo  = 0 0 0 0 0 0
bc.pvec.val.xhi  = 0 0 0 0 0 0
bc.pvec.val.ylo  = 0 0 0 0 0 0
bc.pvec.val.yhi  = 0 0 0 0 0 0
bc.pvec.val.zlo  = 0 0 0 0 0 0
bc.pvec.val.zhi  = 0 0 0 0 0 0

bc.pressure.type.xlo = neumann
bc.pressure.type.xhi = neumann
bc.pressure.type.ylo = neumann
bc.pressure.type.yhi = neumann
bc.pressure.type.zlo = neumann
bc.pressure.type.zhi = neumann

bc.pressure.val.xlo = 0
bc.pressure.val.xhi = 0
bc.pressure.val.ylo = 0
bc.pressure.val.yhi = 0
bc.pressure.val.zlo = 0
bc.pressure.val.zhi = 0

# -------------------------
# DI5 positivity limiter
# -------------------------
enable_di5_face_positivity     = true
di5_partial_density_floor      = 1.0e-12
di5_alpha_floor                = 1.0e-12
di5_pressure_floor             = 1.0e-8
di5_positivity_bisection_iters = 24

# -------------------------
# THINC interface sharpening
# -------------------------
enable_di5_thinc               = true
di5_thinc_beta                 = 0.75
di5_thinc_alpha_eps            = 1.0e-3
di5_thinc_clip_eps             = 1.0e-12
di5_thinc_alpha_jump_min       = 5.0e-2
di5_thinc_max_pressure_jump    = 5.0e-2
di5_thinc_require_monotone     = true

# -------------------------
# Refinement flags off for simple test
# -------------------------
enable_density_refinement   = false
enable_pressure_refinement  = false
enable_velocity_refinement  = false
enable_vorticity_refinement = false
