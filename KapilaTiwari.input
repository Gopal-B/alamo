# ============================================================
# DI5 AXISYMMETRIC NEAR-WALL EXPANSION-COLLAPSE
# Tiwari-Freund-Pantano JCP 2013 strong jetting case
# LOCAL 16-CORE COARSE VERSION + KAPILA K SOURCE
# ============================================================

plot_file = tiwari2013_KapilaK_
timestep  = 2.5e-10
stop_time = 3.0e-4
max_step  = 120000

# ============================================================
# AMR / grid
# ============================================================

amr.plot_int        = 100

amr.max_level       = 3
amr.n_cell          = 384 312 1
amr.ref_ratio       = 2 2 2

amr.blocking_factor = 8
amr.max_grid_size   = 64
amr.grid_eff        = 0.8

amr.regrid_int      = -1

# ============================================================
# Static AMR refinement
# ============================================================

amr.static_refinement.enabled = true

amr.static_refinement.center_x = 0.0
amr.static_refinement.center_y = 0.0

amr.static_refinement.radius_lev0 = 1.20e-2
amr.static_refinement.radius_lev1 = 6.00e-3
amr.static_refinement.radius_lev2 = 3.00e-3

# ============================================================
# Geometry
# ============================================================

geometry.prob_lo     = -1.10e-3  0.0      0.0
geometry.prob_hi     =  3.89e-2  3.25e-2  0.1
geometry.is_periodic = 0 0 0

geometry.mode                          = axisymmetric_xz
geometry.axial_dir                     = 0
geometry.radial_dir                    = 1
geometry.axis_origin                   = 0.0
geometry.axisymmetric_r_epsilon_factor = 0.5
geometry.axisymmetric_apply_axis_bc    = true

# ============================================================
# Solver configuration
# ============================================================

SolverType = SolveFiveEquationModel

FluxReconstruction = WENO
FluxScheme         = HLLC
TimeSteppingScheme = RK3

ReconstructionMode = Primitive
WenoVariant        = WENOIS5

cflNumber = 0.2

# ============================================================
# DI5 robustness controls
# ============================================================

enable_di5_face_positivity     = true

di5_partial_density_floor      = 1.0e-12
di5_alpha_floor                = 1.0e-12
di5_pressure_floor             = 1.0
di5_positivity_bisection_iters = 32

di5.apply_xlo_slip_wall = true
di5.debug_boundary_parity = false

# ============================================================
# Kapila K div(u) alpha source
# ============================================================

enable_kapila_k_source = true
kapila_k_alpha_floor   = 1.0e-10
kapila_k_denom_floor   = 1.0e-20
kapila_k_limit         = true

# ============================================================
# THINC controls
# ============================================================

enable_di5_thinc = false

di5_thinc_beta = 1.10
di5_thinc_alpha_eps = 1.0e-6
di5_thinc_alpha_jump_min = 1.0e-1
di5_thinc_require_monotone = true
di5_thinc_max_pressure_jump = 2.0e-2

# ============================================================
# Material EOS
# ============================================================

ic.shock.pvec.gamma1 = 1.4
ic.shock.pvec.gamma2 = 4.4

ic.shock.pvec.pi1    = 0.0
ic.shock.pvec.pi2    = 6.0e8

# ============================================================
# Initial condition
# ============================================================

ic.pvec.type     = shockdroplet
ic.pressure.type = shockdroplet

ic.shockdroplet.phase1_is_liquid = false

ic.shockdroplet.geometry.bubble_center_x = 0.0
ic.shockdroplet.geometry.bubble_center_y = 0.0
ic.shockdroplet.geometry.bubble_radius   = 2.5e-4

# dx_min = 1.302083333e-5 m.
# 3 finest cells as tanh scale length:
# 3 * dx_min = 3.90625e-5 m
ic.shockdroplet.geometry.interface_thickness = 3.90625e-5

# ============================================================
# Bubble gas state
# ============================================================

ic.shockdroplet.ambient.rho_g = 85.0
ic.shockdroplet.ambient.p     = 5.0e8
ic.shockdroplet.ambient.u     = 0.0
ic.shockdroplet.ambient.v     = 0.0

# ============================================================
# Surrounding water state
# ============================================================

ic.shockdroplet.liquid.rho = 1000.0
ic.shockdroplet.liquid.p   = 1.0e7
ic.shockdroplet.liquid.u   = 0.0
ic.shockdroplet.liquid.v   = 0.0

# ============================================================
# Boundary conditions
# ============================================================

bc.pvec.type.xlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD REFLECT_EVEN REFLECT_EVEN REFLECT_EVEN
bc.pvec.type.xhi = neumann neumann neumann neumann neumann neumann
bc.pvec.type.ylo = neumann neumann neumann neumann neumann neumann
bc.pvec.type.yhi = neumann neumann neumann neumann neumann neumann

bc.pvec.val.xlo = 0 0 0 0 0 0
bc.pvec.val.xhi = 0 0 0 0 0 0
bc.pvec.val.ylo = 0 0 0 0 0 0
bc.pvec.val.yhi = 0 0 0 0 0 0

bc.pressure.type.xlo = neumann
bc.pressure.type.xhi = neumann
bc.pressure.type.ylo = neumann
bc.pressure.type.yhi = neumann

bc.pressure.val.xlo = 0
bc.pressure.val.xhi = 0
bc.pressure.val.ylo = 0
bc.pressure.val.yhi = 0

# ============================================================
# Gradient refinement flags
# ============================================================

enable_density_refinement = false
density_refinement_criterion = 0.2

enable_pressure_refinement = false
pressure_refinement_criterion = 0.15

enable_velocity_refinement = false
velocity_refinement_criterion = 0.1

enable_vorticity_refinement = false
vorticity_refinement_criterion = 0.25
